---
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found | Merge Digital Solutions"
  description="The page you were looking for could not be found."
>
  <a class="skip-link" href="#not-found-content">Skip to content</a>

  <SiteHeader ctaHref="/" ctaLabel="Back to Home" overlay={false} />

  <main id="not-found-content" class="not-found-page">
    <h1 class="sr-only">Page not found</h1>
    <img
      class="not-found-gif"
      src="/assets/404-gif-display.gif"
      alt="404 page not found animation"
    />
    <p>404</p>
  </main>
</BaseLayout>

<style>
  .skip-link {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 30;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-control);
    background: var(--color-ink);
    color: white;
    font-weight: 700;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .not-found-page {
    display: grid;
    min-height: calc(100svh - 6rem);
    place-content: center;
    justify-items: center;
    padding: 2rem 1rem 3rem;
    text-align: center;
  }

  .not-found-gif {
    width: min(calc(100vw - 2rem), calc(100svh - 20rem), 46rem);
    max-height: calc(100svh - 20rem);
    object-fit: contain;
  }

  p {
    margin: 1.25rem 0 0;
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  @media (min-width: 48rem) {
    .not-found-page {
      padding-inline: 2rem;
    }
  }
</style>

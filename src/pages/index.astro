---
import Button from "../components/ui/Button.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Merge Digital Solutions"
  description="We design digital experiences that move your business forward."
>
  <SiteHeader />

  <main>
    <section class="site-container hero">
      <div class="hero__copy">
        <p class="type-label eyebrow">Branding & digital solutions</p>
        <h1 class="type-heading-1">Merge Digital Solutions</h1>
        <p class="type-body-lg hero__intro">
          A focused visual foundation for digital experiences that feel
          organized, professional, and purposefully colorful.
        </p>
        <div class="hero__actions">
          <Button href="/style-guide">Explore the system</Button>
          <Button href="#palette" variant="tertiary" tone="blue">
            Preview the palette
          </Button>
        </div>
      </div>

      <div class="hero__art" aria-hidden="true">
        <img src="/assets/images/abstract-bg.png" alt="" />
      </div>
    </section>

    <section
      id="palette"
      class="site-container palette-preview"
      aria-labelledby="palette-title"
    >
      <div>
        <p class="type-label eyebrow">Core palette</p>
        <h2 id="palette-title" class="type-heading-3">
          Color with a clear purpose.
        </h2>
      </div>
      <div
        class="palette-preview__swatches"
        aria-label="Blue, pink, orange, teal, and purple brand colors"
      >
        <span class="swatch swatch--blue"></span>
        <span class="swatch swatch--pink"></span>
        <span class="swatch swatch--orange"></span>
        <span class="swatch swatch--teal"></span>
        <span class="swatch swatch--purple"></span>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    display: grid;
    min-height: calc(100vh - 12rem);
    align-items: center;
    gap: 2rem;
    padding-block: 3rem var(--section-space);
  }

  .hero__copy {
    position: relative;
    z-index: 1;
    max-width: 43rem;
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: var(--color-brand-blue-strong);
  }

  .hero__intro {
    max-width: 38rem;
    margin: 1.75rem 0 0;
    color: var(--color-text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2.25rem;
  }

  .hero__art {
    min-height: 21rem;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: white;
  }

  .hero__art img {
    width: 100%;
    height: 100%;
    min-height: 21rem;
    object-fit: cover;
  }

  .palette-preview {
    display: grid;
    gap: 2rem;
    padding-block: 3rem;
    border-top: 1px solid var(--color-border);
  }

  .palette-preview__swatches {
    display: grid;
    grid-template-columns: repeat(5, minmax(2.75rem, 1fr));
    gap: 0.75rem;
  }

  .swatch {
    aspect-ratio: 1;
    border-radius: var(--radius-control);
  }

  .swatch--blue {
    background: var(--color-brand-blue);
  }

  .swatch--pink {
    background: var(--color-brand-pink);
  }

  .swatch--orange {
    background: var(--color-brand-orange);
  }

  .swatch--teal {
    background: var(--color-brand-teal);
  }

  .swatch--purple {
    background: var(--color-brand-purple);
  }

  @media (min-width: 52rem) {
    .hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.95fr);
    }

    .hero__art,
    .hero__art img {
      min-height: 34rem;
    }

    .palette-preview {
      grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr);
      align-items: end;
    }
  }
</style>

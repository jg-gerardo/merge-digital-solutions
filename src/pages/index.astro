---
import ContactCtaSection from "../components/sections/ContactCtaSection.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import FeaturedWorksSection from "../components/sections/FeaturedWorksSection.astro";
import ServicesSection from "../components/sections/ServicesSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Merge Digital Solutions"
  description="We design digital experiences that move your business forward."
>
  <SiteHeader />

  <main class="section-stack">
    <HeroSection />
    <ServicesSection />
    <div class="closing-sections">
      <FeaturedWorksSection />
      <ContactCtaSection />
      <SiteFooter />
    </div>
  </main>
</BaseLayout>

<style>
  :global(.section-stack > section:not(:first-of-type)),
  .closing-sections {
    border-top: 1px solid var(--color-border);
  }

  .closing-sections {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .closing-sections::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: url("/assets/images/abstract-bg.png") center / cover no-repeat;
    content: "";
    transform: scaleX(-1);
  }
</style>

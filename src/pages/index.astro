---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Merge Digital Solutions"
  description="We design digital experiences that move your business forward."
>
  <main class="grid min-h-screen place-items-center px-6 py-16">
    <div class="max-w-3xl text-center">
      <h1 class="text-4xl font-semibold tracking-tight sm:text-6xl">
        Merge Digital Solutions
      </h1>
      <p class="mt-6 text-lg text-slate-600 sm:text-xl">
        We design digital experiences that move your business forward.
      </p>
    </div>
  </main>
</BaseLayout>

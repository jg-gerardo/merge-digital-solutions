<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const finePointer = window.matchMedia("(pointer: fine)");

  const motionByPlacement = {
    primary: { distance: 72, easing: 0.017, idleRadius: 7 },
    top: { distance: 60, easing: 0.019, idleRadius: 5 },
    bottom: { distance: 64, easing: 0.021, idleRadius: 6 },
  } as const;

  const returnDelay = 5000;
  const returnEasing = 0.006;
  const clampToRange = (value: number, min: number, max: number) =>
    Math.max(min, Math.min(max, value));
  const clamp = (value: number) => clampToRange(value, -1, 1);

  document
    .querySelectorAll<HTMLElement>("[data-hero-section]")
    .forEach((hero) => {
      const cards = Array.from(
        hero.querySelectorAll<HTMLElement>("[data-hero-card]"),
      ).map((element, index) => ({
        element,
        placement: element.dataset.heroCard as keyof typeof motionByPlacement,
        x: 0,
        y: 0,
        velocityX: 0,
        velocityY: 0,
        targetX: 0,
        targetY: 0,
        idleCenterX: 0,
        idleCenterY: 0,
        idlePhase: index * 2.1,
        isHovered: false,
        returnAt: Number.POSITIVE_INFINITY,
      }));

      if (reducedMotion.matches || !finePointer.matches) return;

      const collisionGap = 1;

      const findSafeTarget = (
        card: (typeof cards)[number],
        desiredX: number,
        desiredY: number,
      ) => {
        const bounds = card.element.getBoundingClientRect();
        const otherBounds = cards
          .filter((otherCard) => otherCard !== card)
          .map((otherCard) => otherCard.element.getBoundingClientRect());
        const distanceX = desiredX - card.x;
        const distanceY = desiredY - card.y;
        const getCollisionDepth = (
          proposedBounds: Pick<DOMRect, "left" | "right" | "top" | "bottom">,
          otherBounds: DOMRect,
        ) => {
          const overlapX =
            Math.min(proposedBounds.right, otherBounds.right + collisionGap) -
            Math.max(proposedBounds.left, otherBounds.left - collisionGap);
          const overlapY =
            Math.min(proposedBounds.bottom, otherBounds.bottom + collisionGap) -
            Math.max(proposedBounds.top, otherBounds.top - collisionGap);

          return overlapX > 0 && overlapY > 0
            ? Math.min(overlapX, overlapY)
            : 0;
        };
        const startingCollisionDepths = otherBounds.map((otherBounds) =>
          getCollisionDepth(bounds, otherBounds),
        );

        const collidesAt = (progress: number) => {
          const offsetX = distanceX * progress;
          const offsetY = distanceY * progress;
          const proposedBounds = {
            left: bounds.left + offsetX,
            right: bounds.right + offsetX,
            top: bounds.top + offsetY,
            bottom: bounds.bottom + offsetY,
          };

          return otherBounds.some(
            (otherBounds, index) =>
              getCollisionDepth(proposedBounds, otherBounds) >
              startingCollisionDepths[index],
          );
        };

        let safeProgress = 0;
        let blockedProgress = 1;

        for (let step = 1; step <= 24; step += 1) {
          const progress = step / 24;

          if (collidesAt(progress)) {
            blockedProgress = progress;
            break;
          }

          safeProgress = progress;
        }

        if (safeProgress === 1) return { x: desiredX, y: desiredY };

        for (let step = 0; step < 6; step += 1) {
          const progress = (safeProgress + blockedProgress) / 2;

          if (collidesAt(progress)) {
            blockedProgress = progress;
          } else {
            safeProgress = progress;
          }
        }

        return {
          x: card.x + distanceX * safeProgress,
          y: card.y + distanceY * safeProgress,
        };
      };

      let animationFrame = 0;

      const render = (time: number) => {
        cards.forEach((card) => {
          const motion = motionByPlacement[card.placement];

          if (!card.isHovered) {
            if (time >= card.returnAt) {
              card.idleCenterX =
                Math.abs(card.idleCenterX) < 0.02
                  ? 0
                  : card.idleCenterX * (1 - returnEasing);
              card.idleCenterY =
                Math.abs(card.idleCenterY) < 0.02
                  ? 0
                  : card.idleCenterY * (1 - returnEasing);
            }

            const horizontalLimit = motion.distance;
            const verticalLimit = motion.distance * 0.72;

            card.targetX = clampToRange(
              card.idleCenterX +
                Math.cos(time * 0.00022 + card.idlePhase) * motion.idleRadius,
              -horizontalLimit,
              horizontalLimit,
            );
            card.targetY = clampToRange(
              card.idleCenterY +
                Math.sin(time * 0.00017 + card.idlePhase) * motion.idleRadius,
              -verticalLimit,
              verticalLimit,
            );
          }

          const remainingX = card.targetX - card.x;
          const remainingY = card.targetY - card.y;
          const desiredX =
            Math.abs(remainingX) < 0.02
              ? card.targetX
              : card.x + remainingX * motion.easing;
          const desiredY =
            Math.abs(remainingY) < 0.02
              ? card.targetY
              : card.y + remainingY * motion.easing;
          const safePosition = findSafeTarget(card, desiredX, desiredY);

          card.velocityX = safePosition.x - card.x;
          card.velocityY = safePosition.y - card.y;
          card.x = safePosition.x;
          card.y = safePosition.y;

          card.element.style.setProperty("--card-x", `${card.x.toFixed(3)}px`);
          card.element.style.setProperty("--card-y", `${card.y.toFixed(3)}px`);
        });

        animationFrame = requestAnimationFrame(render);
      };

      const startAnimation = () => {
        if (!animationFrame) animationFrame = requestAnimationFrame(render);
      };

      cards.forEach((card) => {
        card.element.addEventListener("pointerenter", () => {
          card.isHovered = true;
          card.returnAt = Number.POSITIVE_INFINITY;
        });

        card.element.addEventListener("pointermove", (event) => {
          const bounds = card.element.getBoundingClientRect();
          const x = clamp(
            ((event.clientX - bounds.left) / bounds.width - 0.5) * 2,
          );
          const y = clamp(
            ((event.clientY - bounds.top) / bounds.height - 0.5) * 2,
          );
          const motion = motionByPlacement[card.placement];
          const target = findSafeTarget(
            card,
            x * motion.distance,
            y * motion.distance * 0.72,
          );

          card.targetX = target.x;
          card.targetY = target.y;

          card.element.style.setProperty(
            "--ripple-x",
            `${event.clientX - bounds.left}px`,
          );
          card.element.style.setProperty(
            "--ripple-y",
            `${event.clientY - bounds.top}px`,
          );

          startAnimation();
        });

        card.element.addEventListener("pointerleave", () => {
          const motion = motionByPlacement[card.placement];
          const horizontalLimit = motion.distance;
          const verticalLimit = motion.distance * 0.72;
          const coastTarget = findSafeTarget(
            card,
            clampToRange(
              card.targetX + card.velocityX * 36,
              -horizontalLimit,
              horizontalLimit,
            ),
            clampToRange(
              card.targetY + card.velocityY * 36,
              -verticalLimit,
              verticalLimit,
            ),
          );

          card.idleCenterX = coastTarget.x;
          card.idleCenterY = coastTarget.y;
          card.isHovered = false;
          card.returnAt = performance.now() + returnDelay;
          startAnimation();
        });
      });

      startAnimation();
    });
</script>

---
import Button from "../ui/Button.astro";
---

<section class="contact-cta" id="contact" aria-labelledby="contact-cta-title">
  <div class="site-container" data-section-reveal>
    <div class="contact-cta__card" data-contact-cta>
      <h2 id="contact-cta-title">Let’s build something amazing together.</h2>
      <p>
        Tell us what you’re working on, and we’ll help turn your idea into a
        focused digital experience.
      </p>
      <Button class="contact-cta__button" href="/contact"> Contact Us </Button>
    </div>
  </div>
</section>

<style>
  .contact-cta {
    position: relative;
    z-index: 1;
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .contact-cta__card {
    display: grid;
    min-height: 7.5rem;
    grid-template-columns: minmax(13rem, 0.8fr) minmax(16rem, 1.25fr) auto;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4rem);
    padding: clamp(1.5rem, 3vw, 2.25rem) clamp(1.5rem, 4vw, 3rem);
    border-radius: 0.75rem;
    background: #c8e3ff url("/assets/images/card-design-5.png") center 70% /
      cover no-repeat;
  }

  .contact-cta h2 {
    max-width: 18rem;
    margin: 0;
    color: #111318;
    font-size: clamp(1.2rem, 2vw, 1.4rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .contact-cta p {
    max-width: 25rem;
    margin: 0;
    color: #111318;
    font-size: 0.75rem;
    line-height: 1.35;
  }

  :global(.contact-cta__button.button) {
    min-width: 8rem;
    min-height: 2.25rem;
    padding: 0.6rem 1.5rem;
    font-size: 0.75rem;
  }

  @media (max-width: 48rem) {
    .contact-cta__card {
      min-height: 18rem;
      grid-template-columns: 1fr;
      align-content: center;
      justify-items: start;
      gap: 1.25rem;
      background-position: center;
    }

    .contact-cta h2,
    .contact-cta p {
      max-width: 22rem;
    }
  }
</style>

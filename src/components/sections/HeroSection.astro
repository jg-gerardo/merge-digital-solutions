---
import Button from "../ui/Button.astro";
import HeroCard from "../ui/HeroCard.astro";
import HeroAnimations from "./HeroAnimations.astro";
---

<section
  class="relative grid min-h-svh items-start overflow-clip pt-24 max-[49.99rem]:min-h-0 max-[49.99rem]:pt-28 max-[49.99rem]:pb-16"
  aria-labelledby="hero-title"
  data-hero-section
>
  <img
    class="absolute inset-0 h-full w-full object-cover object-center"
    src="/assets/images/abstract-bg.png"
    alt=""
    width="1200"
    height="800"
    loading="eager"
    fetchpriority="high"
  />

  <div
    class="site-container mt-8 relative z-1 grid grid-cols-[minmax(0,0.92fr)_minmax(24rem,1.08fr)] items-start gap-[clamp(2rem,6vw,6rem)] max-[49.99rem]:mt-0 max-[49.99rem]:grid-cols-1 max-[49.99rem]:gap-4"
    data-section-reveal
  >
    <div
      class="relative z-1 -mt-3 pt-5.25 max-[49.99rem]:mt-0 max-[49.99rem]:pt-4 max-[49.99rem]:pb-8"
    >
      <p
        class="m-0 mb-3.5 text-lg leading-tight font-bold text-brand-blue-strong uppercase"
      >
        Built on expertise, services, and scale.
      </p>

      <h1
        id="hero-title"
        class="m-0 text-[clamp(2.5rem,4.4vw,4.25rem)] leading-[1.15] font-normal tracking-[-0.045em] text-[#111318] max-[29.99rem]:text-[clamp(2.25rem,10.25vw,2.75rem)]"
      >
        <span class="block">We design digital</span>
        <span class="block">experiences that</span>
        <span class="block"
          ><em class="font-serif-accent font-normal text-brand-blue italic"
            >move</em
          >{" "}your business</span
        >
        <span class="block">forward.</span>
      </h1>

      <div class="mt-[0.65rem] mb-4 h-px w-6 bg-current" aria-hidden="true">
      </div>

      <p
        class="m-0 max-w-75 text-md leading-tight font-bold text-[#111318] max-[29.99rem]:max-w-96"
      >
        We build smooth, fast, and user-friendly websites and apps that help
        businesses grow and stand out.
      </p>

      <div class="mt-[0.95rem] flex flex-wrap gap-3">
        <Button href="/style-guide">Explore the system</Button>
        <Button href="/style-guide#colors-title" variant="tertiary" tone="blue">
          Preview the palette
        </Button>
      </div>
    </div>

    <div
      class="relative -mt-4.5 h-[clamp(26rem,calc(100svh-6rem),41rem)] max-[49.99rem]:hidden"
      aria-hidden="true"
      data-hero-visual
    >
      <HeroCard
        src="/assets/images/card-design-1.png"
        width={736}
        height={1308}
        placement="primary"
      />
      <HeroCard
        src="/assets/images/card-design-2.png"
        width={1080}
        height={1920}
        placement="top"
      />
      <HeroCard
        src="/assets/images/card-design-3.png"
        width={1080}
        height={1920}
        placement="bottom"
      />
    </div>
  </div>
</section>
<HeroAnimations />

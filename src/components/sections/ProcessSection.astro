---
const processSteps = [
  {
    title: "Discover",
    description:
      "We learn about your business, audience, challenges, and goals.",
    color: "teal",
  },
  {
    title: "Define",
    description:
      "We shape a focused strategy and a clear path for the project.",
    color: "orange",
  },
  {
    title: "Design",
    description:
      "We turn the strategy into intuitive, engaging digital experiences.",
    color: "pink",
  },
  {
    title: "Deliver",
    description:
      "We build, refine, and launch a polished solution ready to grow.",
    color: "purple",
  },
] as const;
---

<section class="process-section" id="process" aria-labelledby="process-title">
  <div class="site-container process-section__layout" data-section-reveal>
    <div class="process-section__introduction">
      <p class="process-section__eyebrow">Our process</p>
      <h2 id="process-title">
        We build smooth, fast, and user-friendly websites and apps that help
        businesses grow and stand out.
      </h2>
    </div>

    <ol class="process-section__steps">
      {
        processSteps.map(({ title, description, color }, index) => (
          <li class="process-step" data-process-step>
            <div class="process-step__marker">
              <span class="process-step__number" data-color={color}>
                {index + 1}
              </span>
              {index < processSteps.length - 1 && (
                <span class="process-step__line" aria-hidden="true" />
              )}
            </div>
            <h3>{title}</h3>
            <p>{description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process-section {
    padding-block: clamp(3rem, 5vw, 4.5rem);
    background: var(--color-surface);
  }

  .process-section__layout {
    display: grid;
    grid-template-columns: minmax(15rem, 0.78fr) minmax(0, 1.52fr);
    gap: clamp(3rem, 8vw, 7.5rem);
    align-items: start;
  }

  .process-section__eyebrow {
    margin: 0 0 1.35rem;
    color: var(--color-brand-blue-strong);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .process-section h2 {
    margin: 0;
    color: #111318;
    font-size: clamp(1.5rem, 2.5vw, 1.75rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .process-section__steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process-step__marker {
    display: flex;
    align-items: center;
    min-height: 1.5rem;
  }

  .process-step__number {
    display: grid;
    width: 1.5rem;
    flex: 0 0 1.5rem;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 50%;
    background: #404145;
    color: var(--step-color);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
  }

  .process-step__number[data-color="teal"] {
    --step-color: var(--color-brand-teal);
  }

  .process-step__number[data-color="orange"] {
    --step-color: var(--color-brand-orange);
  }

  .process-step__number[data-color="pink"] {
    --step-color: var(--color-brand-pink);
  }

  .process-step__number[data-color="purple"] {
    --step-color: var(--color-brand-purple);
  }

  .process-step__line {
    width: 100%;
    height: 1px;
    margin-inline: 0.85rem 0;
    background: var(--color-border);
  }

  .process-step h3 {
    margin: 1.3rem 0 0.55rem;
    color: #111318;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .process-step p {
    margin: 0;
    color: #111318;
    font-size: 0.75rem;
    line-height: 1.35;
  }

  @media (max-width: 55rem) {
    .process-section__layout {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .process-section__introduction {
      max-width: 34rem;
    }
  }

  @media (max-width: 40rem) {
    .process-section__steps {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .process-step {
      position: relative;
      display: grid;
      grid-template-columns: 1.5rem 1fr;
      column-gap: 1rem;
      padding-bottom: 2rem;
    }

    .process-step__marker {
      grid-row: 1 / span 2;
      flex-direction: column;
    }

    .process-step__line {
      width: 1px;
      height: 100%;
      margin: 0.5rem 0 0;
    }

    .process-step h3 {
      margin: 0.15rem 0 0.55rem;
    }
  }
</style>

---
import Button from "./ui/Button.astro";

const navigation = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Services", href: "/services" },
  { label: "Works", href: "/works" },
  { label: "Contact", href: "/contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header" data-site-header>
  <div class="site-container site-header__inner">
    <a
      class="site-header__brand"
      href="/"
      aria-label="Merge Digital Solutions home"
    >
      <img src="/merge-logo-main.png" alt="" width="2172" height="724" />
    </a>

    <nav
      class="site-header__nav"
      id="primary-navigation"
      aria-label="Primary navigation"
      data-navigation
    >
      <div class="site-header__mobile-brand">
        <a href="/" aria-label="Merge Digital Solutions home">
          <img src="/merge-logo-main.png" alt="" width="2172" height="724" />
        </a>
      </div>

      <div class="site-header__links">
        {
          navigation.map(({ label, href }) => (
            <a
              class="site-header__link"
              href={href}
              aria-current={currentPath === href ? "page" : undefined}
            >
              {label}
            </a>
          ))
        }
      </div>

    </nav>

    <div class="site-header__actions">
      <Button class="site-header__cta" href="/contact" variant="secondary">
        Let&apos;s Talk
      </Button>
      <button
        class="site-header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primary-navigation"
        aria-label="Open navigation"
        data-navigation-toggle
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
  <div
    class="site-header__backdrop"
    aria-hidden="true"
    data-navigation-backdrop
  >
  </div>
</header>

<script>
  const headers = document.querySelectorAll<HTMLElement>("[data-site-header]");

  headers.forEach((header) => {
    const toggle = header.querySelector<HTMLButtonElement>(
      "[data-navigation-toggle]",
    );
    const navigation = header.querySelector<HTMLElement>("[data-navigation]");
    const backdrop = header.querySelector<HTMLElement>(
      "[data-navigation-backdrop]",
    );

    if (!toggle || !navigation || !backdrop) return;

    const setMenuOpen = (isOpen: boolean) => {
      toggle.setAttribute("aria-expanded", String(isOpen));
      toggle.setAttribute(
        "aria-label",
        isOpen ? "Close navigation" : "Open navigation",
      );
      navigation.toggleAttribute("data-open", isOpen);
      backdrop.toggleAttribute("data-open", isOpen);
      header.toggleAttribute("data-navigation-open", isOpen);
      document.documentElement.toggleAttribute("data-navigation-open", isOpen);
    };

    toggle.addEventListener("click", () => {
      setMenuOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    navigation.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setMenuOpen(false);
    });

    backdrop.addEventListener("click", () => setMenuOpen(false));

    document.addEventListener("click", (event) => {
      if (!header.contains(event.target as Node)) setMenuOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setMenuOpen(false);
        toggle.focus();
      }
    });

    window
      .matchMedia("(min-width: 48rem)")
      .addEventListener("change", (event) => {
        if (event.matches) setMenuOpen(false);
      });
  });
</script>

<style>
  .site-header {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    z-index: 20;
    background: transparent;
  }

  .site-header__inner {
    position: relative;
    display: grid;
    min-height: 6rem;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem;
    padding-bottom: 1rem;
  }

  .site-header__brand {
    width: clamp(7.5rem, 11vw, 8.5rem);
  }

  .site-header__brand img {
    width: 100%;
    height: auto;
  }

  .site-header__nav {
    justify-self: center;
  }

  .site-header__links {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.25rem);
  }

  .site-header__mobile-brand,
  .site-header__backdrop {
    display: none;
  }

  .site-header__link {
    position: relative;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: 0.125rem;
    color: var(--color-text);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
  }

  .site-header__link::after {
    position: absolute;
    right: 0.125rem;
    bottom: 0.25rem;
    left: 0.125rem;
    height: 1px;
    background: currentColor;
    content: "";
    opacity: 0;
    transform: scaleX(0.35);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .site-header__link:hover::after,
  .site-header__link[aria-current="page"]::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  :global(.site-header__cta.button) {
    min-height: 2.5rem;
    padding-inline: 1.25rem;
    border-radius: 0.625rem;
    font-size: 0.75rem;
  }

  .site-header__toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  .site-header__toggle span {
    position: absolute;
    width: 1.125rem;
    height: 1px;
    background: currentColor;
    transition: transform 160ms ease;
  }

  .site-header__toggle span:first-child {
    transform: translateY(-0.25rem);
  }

  .site-header__toggle span:last-child {
    transform: translateY(0.25rem);
  }

  .site-header__toggle[aria-expanded="true"] span:first-child {
    transform: rotate(45deg);
  }

  .site-header__toggle[aria-expanded="true"] span:last-child {
    transform: rotate(-45deg);
  }

  @media (max-width: 47.99rem) {
    :global(html[data-navigation-open]) {
      overflow: hidden;
    }

    .site-header__inner {
      min-height: 5rem;
      grid-template-columns: 1fr auto;
      gap: 1rem;
      padding-bottom: 0.75rem;
    }

    .site-header__nav {
      position: fixed;
      z-index: 2;
      top: 0;
      bottom: 0;
      left: 0;
      display: flex;
      width: 75vw;
      flex-direction: column;
      justify-self: auto;
      padding: 1rem;
      background: color-mix(in srgb, var(--color-surface) 96%, transparent);
      box-shadow: 1rem 0 3rem rgb(32 35 46 / 18%);
      pointer-events: none;
      transform: translateX(-100%);
      visibility: hidden;
      transition:
        transform 240ms cubic-bezier(0.22, 1, 0.36, 1),
        visibility 240ms;
    }

    .site-header__nav[data-open] {
      pointer-events: auto;
      transform: translateX(0);
      visibility: visible;
    }

    .site-header__mobile-brand {
      display: flex;
      min-height: 5rem;
      align-items: center;
      border-bottom: 1px solid var(--color-border);
    }

    .site-header__mobile-brand a {
      width: 8.5rem;
    }

    .site-header__mobile-brand img {
      width: 100%;
      height: auto;
    }

    .site-header[data-navigation-open]
      .site-header__inner
      > .site-header__brand {
      visibility: hidden;
    }

    .site-header__links {
      display: grid;
      gap: 0.4rem;
      margin-top: 1.25rem;
    }

    .site-header__link {
      min-height: 3.25rem;
      padding-inline: 1rem;
      border: 1px solid transparent;
      border-radius: 0.625rem;
      font-size: 0.875rem;
      transition:
        color 160ms ease,
        background-color 160ms ease,
        border-color 160ms ease;
    }

    .site-header__link:hover,
    .site-header__link[aria-current="page"] {
      border-color: color-mix(
        in srgb,
        var(--color-brand-blue) 18%,
        transparent
      );
      background: color-mix(in srgb, var(--color-brand-blue) 8%, transparent);
      color: var(--color-brand-blue-strong);
    }

    .site-header__link::after {
      display: none;
    }

    .site-header__backdrop {
      position: fixed;
      z-index: 1;
      inset: 0;
      display: block;
      background: rgb(17 19 24 / 28%);
      opacity: 0;
      pointer-events: none;
      visibility: hidden;
      transition:
        opacity 200ms ease,
        visibility 200ms;
    }

    .site-header__backdrop[data-open] {
      opacity: 1;
      pointer-events: auto;
      visibility: visible;
    }

    .site-header__actions {
      position: relative;
      z-index: 3;
      justify-self: end;
    }

    :global(.site-header__cta.button) {
      display: none;
    }

    .site-header[data-navigation-open] :global(.site-header__cta.button) {
      position: fixed;
      z-index: 3;
      right: auto;
      bottom: 1rem;
      left: 1rem;
      display: inline-flex;
      width: calc(75vw - 2rem);
      border-radius: 0.625rem;
      background: var(--color-surface);
    }

    .site-header__toggle {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }

  @media (max-width: 25rem) {
    :global(.site-header__cta.button) {
      min-height: 2.375rem;
      padding-inline: 0.875rem;
    }

    .site-header__actions {
      gap: 0.5rem;
    }
  }
</style>
